{
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write/MultiEdit on UI files, full-rule deep pass on Stop.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\skyle\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\hook.mjs\" ] || node \"C:\\\\Users\\\\skyle\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /c/Users/skyle/Projects/Planner 2>/dev/null || exit 0; L=.claude/.devserver.pid; if [ -f \"$L\" ] && kill -0 \"$(cat \"$L\" 2>/dev/null)\" 2>/dev/null; then exit 0; fi; unset ELECTRON_RUN_AS_NODE; nohup npm run dev >.claude/devserver.log 2>&1 & echo $! > \"$L\"; disown 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Ensuring dev server"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\skyle\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\hook.mjs\" ] || node \"C:\\\\Users\\\\skyle\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
